# ── Company Research AI — environment variables ──────────────────────────────
# Copy this file to `.env.local` for local dev, or set these in your host's
# dashboard (Vercel → Project → Settings → Environment Variables).
#
# NOTE: every key below is OPTIONAL — users can paste their own keys in the
# app's sidebar instead (stored in their browser, sent per-request). Server
# keys act as the zero-setup fallback so the deployed demo "just works".

# OpenRouter — AI analysis (free-tier models work without credits)
# Get one at: https://openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Serper.dev — Google search API (2,500 free queries)
# Get one at: https://serper.dev
SERPER_API_KEY=your-serper-key-here

# Discord bot token — OPTIONAL fallback for the Discord bonus integration.
# Normally the evaluator pastes the bot token in the app's Discord settings tab.
# DISCORD_BOT_TOKEN=your-bot-token-here
